                for _, child in ipairs(part:GetChildren()) do child:Destroy() end
                part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.CastShadow=false
                part.TextureID="";part.MaterialVariant="";part.Material=Enum.Material.ForceField;part.Color=rgb("cosmeticColour");part.Transparency=0.55;part.Parent=model
            end
            if config.shadowStyle=="Shards" then part.Size=part.Size*0.35;part.Material=Enum.Material.Neon
            elseif config.shadowStyle=="Constellation" then part.Shape=Enum.PartType.Ball;part.Size=Vector3.one*0.16;part.Material=Enum.Material.Neon end
        end
    end
    if config.shadowStyle=="Constellation" then
        local previous
        for _,part in ipairs(model:GetChildren()) do if part:IsA("BasePart") then
            local attachment=create("Attachment",{},part)
            if previous then create("Beam",{Attachment0=previous,Attachment1=attachment,FaceCamera=true,Width0=0.025,Width1=0.025,Color=ColorSequence.new(rgb("cosmeticColour")),Transparency=NumberSequence.new(0.6)},part) end
            previous=attachment
        end end
    end
