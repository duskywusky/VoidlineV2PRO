local function segment(pool, camera, a, b, color)
    -- Clip in camera space before projecting segments crossing the near plane.
    local ca, cb = camera.CFrame:PointToObjectSpace(a), camera.CFrame:PointToObjectSpace(b)
    if ca.Z > -0.1 and cb.Z > -0.1 then return end
    if ca.Z > -0.1 then ca = ca:Lerp(cb, (-0.1 - ca.Z) / (cb.Z - ca.Z)) end
    if cb.Z > -0.1 then cb = cb:Lerp(ca, (-0.1 - cb.Z) / (ca.Z - cb.Z)) end
    local pa = project(camera, camera.CFrame:PointToWorldSpace(ca))
    local pb = project(camera, camera.CFrame:PointToWorldSpace(cb))
    if (pa - pb).Magnitude < 16000 then Draw.line(pool, pa, pb, color) end
end
