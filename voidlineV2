do
    local model,parts,dirty=nil,{},true
    local listeners={}
    function Studio.clearLocalParts()
        for _,connection in ipairs(listeners) do connection:Disconnect() end
        listeners={};model=nil;parts={};dirty=true
    end
    function Studio.localParts(source)
        if model~=source then
            Studio.clearLocalParts();model=source
            if source then
                local function changed(object) if object:IsA("BasePart") then dirty=true end end
                listeners={source.DescendantAdded:Connect(changed),source.DescendantRemoving:Connect(changed)}
            end
        end
        if dirty then
            parts={}
            if source then for _,object in ipairs(source:GetDescendants()) do if object:IsA("BasePart") then parts[#parts+1]=object end end end
            dirty=false
        end
        return parts
    end
end
