S.RunService:BindToRenderStep("DuskStudioRender", Enum.RenderPriority.Last.Value + 1, function(dt)
    local camera = S.Workspace.CurrentCamera; if not camera or not alive then return end
    if Studio.tick then Studio.tick(dt,camera) end
    dt = math.min(dt, 0.1)
    guarded("Camera", cameraUpdate, camera, dt)
    guarded("Aim", aimUpdate, camera, dt)
    local _, _, root = character(player)
    Studio.visualElapsed=(Studio.visualElapsed or 0)+dt
    if Studio.visualElapsed>=1/config.visualRate or Studio.lastESPCamera~=camera.CFrame then Studio.visualElapsed=0;Studio.lastESPCamera=camera.CFrame;guarded("Visuals", espUpdate, camera, os.clock()) end
    Studio.effectElapsed=(Studio.effectElapsed or 0)+dt
    if Studio.effectElapsed>=1/config.effectRate then
        local step=Studio.effectElapsed;Studio.effectElapsed=0
        guarded("Weather", weatherUpdate, camera, step)
        guarded("Sky", skyFXUpdate, camera, os.clock())
        guarded("Cosmetics", cosmeticsUpdate, root, os.clock(), step)
        guarded("Shadow step",shadowUpdate,root,os.clock())
        if Studio.render then guarded("Studio effects",Studio.render,camera,root,step) end
        guarded("Astral mist",Studio.cosmeticMist)
    end
    guarded("Avatar costume",costumeRender)
    guarded("Preview", previewUpdate, dt, os.clock())
    guarded("Crosshair preview",Studio.reticlePreview)
