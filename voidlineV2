-- Effects are local; server-authoritative movement rules still apply.
local S = {}
for _, name in ipairs({"Players", "RunService", "UserInputService", "Lighting", "HttpService", "TweenService", "Workspace", "GuiService"}) do
    S[name] = game:GetService(name)
end
local player = S.Players.LocalPlayer
assert(player, "Dusk requires a client LocalScript")
local playerGui = player:WaitForChild("PlayerGui")
local previous = playerGui:FindFirstChild("DuskStudio")
if previous then
    local stop = previous:FindFirstChild("Shutdown")
    if stop then stop:Fire() end
    previous:Destroy()
end
local function create(class, properties, parent)
    local object = Instance.new(class)
    for key, value in pairs(properties or {}) do object[key] = value end
    object.Parent = parent
    return object
end
local connections, patches = {}, {}
local patchOwners={}
local alive = true
local function connect(signal, callback)
    local connection = signal:Connect(callback)
    connections[#connections + 1] = connection
    return connection
end
-- Capture each property once; restore it when its feature stops owning it.
local function patch(object, property, value, owner)
    if not object then return end
    local record = patches[object]
    if not record then record = {}; patches[object] = record end
    if not record[property] then record[property] = {original = object[property], owner = owner};if owner then patchOwners[owner]=true end end
    if object[property] ~= value then object[property] = value end
end
local function restore(owner)
    if owner and not patchOwners[owner] then return end
    if (not owner or owner == "third") and patches[player] then
        local record = patches[player]
        local minimum, maximum = record.CameraMinZoomDistance, record.CameraMaxZoomDistance
        if minimum and maximum then
            player.CameraMinZoomDistance = 0
            player.CameraMaxZoomDistance = maximum.original
            player.CameraMinZoomDistance = minimum.original
            record.CameraMinZoomDistance = nil; record.CameraMaxZoomDistance = nil
        end
    end
    for object, record in pairs(patches) do
        for property, entry in pairs(record) do
            if not owner or entry.owner == owner then
                pcall(function() object[property] = entry.original end)
                record[property] = nil
            end
        end
        if not next(record) then patches[object] = nil end
    end
    if owner then patchOwners[owner]=nil else patchOwners={} end
end
