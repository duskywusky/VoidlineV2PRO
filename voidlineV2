local function applySkin()
    local skins = {
        Frost = {"BDEAFF", "Glass", "Solid", 0.15},
        Obsidian = {"252139", "Metal", "Solid", 0},
        Solar = {"FFB34D", "Neon", "Pulse", 0.1},
        Spectral = {"AFCFFF", "ForceField", "Ghost", 0.75},
        Prismatic = {"FFFFFF", "Neon", "Rainbow", 0.15},
    }
    local skin = skins[config.skin]; if not skin then return end
    config.stripTextures = true
    for _, area in ipairs({"arms", "body"}) do
        config[area] = true; config[area .. "Colour"] = skin[1]; config[area .. "Material"] = skin[2]
        config[area .. "Style"] = skin[3]; config[area .. "Alpha"] = skin[4]
    end
end
