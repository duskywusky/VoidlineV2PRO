local function valid(entry, value)
    if entry.kind == "toggle" then return type(value) == "boolean" end
    if entry.kind == "slider" then return type(value) == "number" and value == value and value >= entry.min and value <= entry.max end
    if type(value) ~= "string" or #value > 200 then return false end
    if entry.kind == "choice" then return table.find(entry.values, value) ~= nil end
    if entry.kind == "colour" then return #value == 6 and string.match(value, "^%x+$") ~= nil end
    if entry.kind == "key" then return value == "MouseButton2" or value == "MouseButton3" or (Enum.KeyCode[value] ~= nil and value ~= "Unknown") end
    if entry.kind == "asset" then return value == "" or string.match(value, "^%d+$") ~= nil end
    return true
end
