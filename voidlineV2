            end
        end end
    end
    if not shadows.position then shadows.position=root.Position;return end
    if now-shadows.last<0.14/math.max(Studio.quality,0.25) or (root.Position-shadows.position).Magnitude<0.9 or #shadows.items>=math.ceil(8*Studio.quality) then return end
    shadows.last=now;shadows.position=root.Position
