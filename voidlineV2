local function clearCostume()
    costume.generation=costume.generation+1
    if costume.model then costume.model:Destroy() end
    costume.model=nil;costume.parts={};costume.joints={};costume.hidden={};restore("costume")
end
local function costumeUpdate()
    local source,humanoid=character(player)
    if config.avatarCostume=="Default" or not source then
        if costume.model or costume.source then clearCostume();costume.source=nil;costume.signature="" end
        return
    end
    local signature=config.avatarCostume..":"..config.avatarUserId..":"..config.avatarOutfitId
    if costume.source==source and costume.signature==signature then return end
    clearCostume();costume.source=source;costume.signature=signature
    local generation=costume.generation
    local mode,userId,outfitId=config.avatarCostume,tonumber(config.avatarUserId),tonumber(config.avatarOutfitId)
    UI.notice("Loading avatar costume...")
    task.spawn(function()
        local description
        local ok,result=pcall(function()
            if Studio.avatarOutfits[mode] then
                local outfit=Studio.avatarOutfits[mode]
                assert(not outfit.r15 or humanoid.RigType==Enum.HumanoidRigType.R15,"This costume requires an R15 character; try Korblox or Headless on R6")
                description=S.Players:GetHumanoidDescriptionFromOutfitIdAsync(outfit.id)
            elseif mode=="User avatar" or mode=="Roblox" then
                local id=mode=="Roblox" and 1 or userId;assert(id and id>0,"Enter a valid user ID")
                description=S.Players:GetHumanoidDescriptionFromUserIdAsync(id)
            elseif mode=="Saved outfit" then
                assert(outfitId and outfitId>0,"Enter a valid outfit ID")
                description=S.Players:GetHumanoidDescriptionFromOutfitIdAsync(outfitId)
            else
                description=create("HumanoidDescription")
                local head,torso,legs=Color3.fromRGB(245,205,48),Color3.fromRGB(13,105,172),Color3.fromRGB(164,189,71)
                if mode=="Zombie" then head=Color3.fromRGB(99,143,75);torso=Color3.fromRGB(73,84,64);legs=Color3.fromRGB(49,56,46)
                elseif mode=="Classic Blocky" then head=Color3.fromRGB(163,162,165);torso=Color3.fromRGB(35,35,40);legs=Color3.fromRGB(55,77,105) end
                description.HeadColor=head;description.LeftArmColor=head;description.RightArmColor=head
                description.TorsoColor=torso;description.LeftLegColor=legs;description.RightLegColor=legs
            end
            return S.Players:CreateHumanoidModelFromDescriptionAsync(description,humanoid.RigType)
        end)
        if description then description:Destroy() end
        if not alive or generation~=costume.generation then if ok then result:Destroy() end;return end
        if not ok then UI.notice("Avatar failed to load: "..tostring(result):sub(1,130));return end
        local pairs={}
        for _, part in ipairs(result:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.CastShadow=false
                local body=result:FindFirstChild(part.Name)
                local offset=CFrame.new()
                if part:FindFirstAncestorOfClass("Accessory") then
                    local weld=part:FindFirstChild("AccessoryWeld")
                    body=weld and weld.Part1
                    if body then offset=body.CFrame:ToObjectSpace(part.CFrame) end
                end
                local original=body and source:FindFirstChild(body.Name)
                if original and original:IsA("BasePart") then pairs[#pairs+1]={part=part,source=original,body=body,accessory=part:FindFirstAncestorOfClass("Accessory")~=nil,offset=offset} else part.Transparency=1 end
            end
        end
        -- Preserve the costume's joint spacing; copying source part centres breaks
        -- differently proportioned bundles. Replay source poses on costume anchors.
        local sourceMotors={}
        for _,motor in ipairs(source:GetDescendants()) do if motor:IsA("Motor6D") and motor.Part1 then sourceMotors[motor.Part1.Name]=motor end end
        local pending={};local ordered={};local ready={}
        local generatedRoot=result:FindFirstChild("HumanoidRootPart");if generatedRoot then ready[generatedRoot]=true end
        for _,motor in ipairs(result:GetDescendants()) do
            if motor:IsA("Motor6D") and motor.Part0 and motor.Part1 then pending[#pending+1]=motor end
        end
        for _=1,#pending do
            local progress=false
            for i=#pending,1,-1 do
                local motor=pending[i]
                if ready[motor.Part0] then
                    ordered[#ordered+1]={parent=motor.Part0,part=motor.Part1,c0=motor.C0,c1=motor.C1,source=sourceMotors[motor.Part1.Name]}
                    ready[motor.Part1]=true;table.remove(pending,i);progress=true
                end
            end
            if not progress then break end
        end
        for _, object in ipairs(result:GetDescendants()) do
            if object:IsA("LuaSourceContainer") or object:IsA("JointInstance") or object:IsA("Constraint") or object:IsA("Animator") then object:Destroy()
            elseif object:IsA("Humanoid") then object.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None end
        end
        costume.model=result;costume.parts=pairs;costume.joints=ordered;costume.root=generatedRoot;result.Name="DuskAvatarCostume";result.Parent=effects
        UI.notice("Avatar costume loaded locally. Default restores your appearance.")
    end)
end
local function costumeRender()
    if not costume.model or not costume.source then return end
    for _, part in ipairs(Studio.localParts(costume.source)) do
        if part:IsA("BasePart") and not part:FindFirstAncestorOfClass("Tool") then patch(part,"LocalTransparencyModifier",1,"costume") end
    end
    for _, pair in ipairs(costume.parts) do if pair.source.Parent and pair.part.Parent then pair.part.CFrame=pair.source.CFrame*pair.offset end end
    if costume.root and costume.root.Parent then costume.root.CFrame=costume.root.CFrame*CFrame.new(0,Studio.floatLift or 0,0) end
    for _,joint in ipairs(costume.joints or {}) do
        if joint.parent.Parent and joint.part.Parent then
            local pose=CFrame.new();local source=joint.source
            if source and source.Parent and source.Part0 and source.Part1 then
                pose=source.C0:Inverse()*source.Part0.CFrame:ToObjectSpace(source.Part1.CFrame)*source.C1
            end
            joint.part.CFrame=joint.parent.CFrame*joint.c0*pose*joint.c1:Inverse()
        end
    end
    for _,pair in ipairs(costume.parts) do
        if pair.accessory and pair.body and pair.body.Parent and pair.part.Parent then pair.part.CFrame=pair.body.CFrame*pair.offset end
    end
end
