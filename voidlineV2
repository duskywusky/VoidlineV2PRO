end

-- Local avatar costumes follow the real rig; they never replace its physics or account avatar.
local costume={model=nil,source=nil,signature="",generation=0,parts={},hidden={}}
-- Full outfit IDs verified against Roblox's bundle metadata, not material presets.
Studio.avatarOutfits={
    ["Redcliff Paladin"]={id=320912307,r15=true},
    ["Korblox Deathspeaker"]={id=131929437},
    ["Headless Horseman"]={id=131929448},
    ["Pirate Queen"]={id=320922271,r15=true},
