        if not last or last.key~=key or os.clock()-last.time>0.5 then
            local snapshot={};for k,v in pairs(config) do snapshot[k]=v end
            table.insert(Studio.history,{values=snapshot,key=key,time=os.clock()});if #Studio.history>40 then table.remove(Studio.history,1) end
