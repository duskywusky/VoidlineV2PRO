connect(S.UserInputService.InputBegan, function(input, processed)
    local key = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode.Name or input.UserInputType.Name
    if UI.capture then
        if key == "Escape" then UI.capture = nil; UI.refresh(); return end
        local binding = UI.capture
        if UI.set(binding, key) then UI.capture = nil; UI.refresh() end
        return
    end
    if S.UserInputService:GetFocusedTextBox() then return end
    if key == config.panicKey then cleanup(); return end
    if key == "Escape" and window.Visible then
        if UI.popup then UI.closePopup() else window.Visible = false end
        return
    end
    if processed then return end
    if key == config.menuKey then UI.closePopup(); window.Visible = not window.Visible
    elseif key == config.freecamKey then UI.set("freecam",config.freecamMode=="Hold" or not config.freecam)
    elseif key == config.shoulderKey then UI.set("cameraShoulder",config.cameraShoulder==0 and 1.5 or -config.cameraShoulder)
    elseif key == config.flightKey then UI.set("flight",config.flightMode=="Hold" or not config.flight)
    elseif key == config.noclipKey then UI.set("noclip",config.noclipMode=="Hold" or not config.noclip) end
end)
connect(S.UserInputService.InputEnded,function(input)
    local key=input.KeyCode~=Enum.KeyCode.Unknown and input.KeyCode.Name or input.UserInputType.Name
    for _,name in ipairs({"freecam","flight","noclip"}) do if config[name.."Mode"]=="Hold" and key==config[name.."Key"] then UI.set(name,false) end end
end)
local errorTimes = {}
local function guarded(name, callback, ...)
    local ok, err = pcall(callback, ...)
    local diagnostic=Studio.diagnostics[name]
    if not diagnostic then diagnostic={};Studio.diagnostics[name]=diagnostic end
    diagnostic.state=ok and "Active" or "Failed";diagnostic.time=os.clock()
    diagnostic.message=not ok and tostring(err):sub(1,240) or nil
    if not ok and os.clock() - (errorTimes[name] or -10) > 5 then
        errorTimes[name] = os.clock(); warn("Dusk / " .. name .. ": " .. tostring(err)); UI.notice(name .. " error; see client console.")
    end
end
