    elseif UI.sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input == UI.sliding.touch) then
        local entry, track = UI.sliding.entry, UI.sliding.track
        local ratio = math.clamp((input.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        UI.set(entry.key, math.clamp(math.floor((entry.min+ratio*(entry.max-entry.min))/entry.step+0.5)*entry.step,entry.min,entry.max))
    elseif UI.drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input == UI.drag.touch) then
        local delta = input.Position - UI.drag.start
        UI.userMoved=true
        window.Position = UI.drag.position + UDim2.fromOffset(delta.X, delta.Y)
    end
end)
connect(S.UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then UI.drag = nil; UI.sliding = nil; UI.colourDrag=nil end
end)
